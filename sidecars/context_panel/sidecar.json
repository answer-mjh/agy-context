{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Antigravity Context",
  "description": "Cross-session context insights, per-request timeline (Total/Delta/Overview), Context Browser & DNA view, context events, file activity, and command execution analytics.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Antigravity Context",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Context"
      },
      {
        "path": "/full",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Context Insights"
      }
    ]
  }
}
